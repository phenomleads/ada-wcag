{
  "name": "ada-wcag-accessibility-checker",
  "version": "1.0.0",
  "description": "CLI tool that audits a URL or local HTML file against WCAG 2.1 Level AA success criteria and produces a structured JSON report.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.0",
    "http-server": "^14.1.1",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
