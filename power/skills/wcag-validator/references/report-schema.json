{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccessibilityReport",
  "description": "JSON report structure produced by the ada-wcag accessibility checker, per Requirement 10.",
  "type": "object",
  "required": ["metadata", "violations", "violationsByWCAG"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["source", "timestamp", "totalViolations", "errorCount", "warningCount"],
      "properties": {
        "source": {
          "type": "string",
          "description": "The URL or file path that was analyzed."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the report was generated."
        },
        "totalViolations": {
          "type": "integer",
          "minimum": 0,
          "description": "Equal to violations.length."
        },
        "errorCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of violations with severity 'error'."
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of violations with severity 'warning'."
        }
      }
    },
    "violations": {
      "type": "array",
      "items": { "$ref": "#/definitions/Violation" }
    },
    "violationsByWCAG": {
      "type": "object",
      "description": "Violations grouped by WCAG criterion. Every violation in `violations` appears in exactly one group here.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/Violation" }
      }
    }
  },
  "definitions": {
    "Violation": {
      "type": "object",
      "required": ["wcag", "severity", "element", "issue", "fix"],
      "properties": {
        "wcag": {
          "type": "string",
          "enum": ["1.1.1", "1.3.1", "1.4.3", "2.4.4"],
          "description": "WCAG 2.1 success criterion reference."
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning"],
          "description": "'error' = must fix, 'warning' = should fix. No other values are valid."
        },
        "element": {
          "type": "string",
          "description": "HTML element identifier, e.g. \"<img>\"."
        },
        "issue": {
          "type": "string",
          "description": "Human-readable description of the specific problem found."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based line number in the source HTML, if available."
        },
        "fix": {
          "type": "string",
          "description": "Canonical remediation suggestion text for this violation type."
        }
      }
    }
  }
}
